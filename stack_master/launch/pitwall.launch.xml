<!-- -*- mode: XML -*- -->
<!--
  pitwall.launch.xml — open RViz with the stack_master pitwall config (Sim Control
  + telemetry panel). Mirrors pitwall/launch/pitwall.launch.py but uses the rviz
  config shipped in stack_master. More tools may be added here later.
-->
<launch>
  <arg name="rviz_config"
       default="$(find-pkg-share stack_master)/config/pitwall.rviz"
       description="RViz config to load"/>
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        args="-d $(var rviz_config)"/>

  <node pkg="rqt_reconfigure" exec="rqt_reconfigure" name="rqt_reconfigure" output="screen"/>

  <!-- ===== 차가 디버그를 끊으면 이 창들도 같이 닫는다 =====
       race.launch.xml 을 debug:=off 로 띄우고 조이스틱 RB 를 누르면, 차의
       race_supervisor 가 /debug_enabled 에 false 를 latch 발행한다. RViz 는 이
       랩탑에서 뜨므로 차가 직접 죽일 수 없어, 그 신호를 여기서 받아 닫는다.

       편의 기능이 아니라 차의 CPU 문제이기도 하다: 랩탑이 마커 토픽을 계속
       구독하고 있으면 차의 노드들이 get_subscription_count() > 0 을 보고 마커를
       계속 만든다. 랩탑을 닫아야 그게 실제로 멈춘다.

       구독이 latch 라 순서가 뒤바뀌어도(차가 먼저 RB 를 받은 뒤 pitwall 을 띄워도)
       마지막 상태를 받아 바로 닫는다. 끄고 싶으면 watchdog:=false. -->
  <arg name="watchdog" default="true"
       description="차의 /debug_enabled 가 false 가 되면 RViz 를 자동 종료할지 여부"/>
  <node pkg="stack_master" exec="pitwall_watchdog_node.py" name="pitwall_watchdog"
        output="screen" if="$(var watchdog)"/>
</launch>

