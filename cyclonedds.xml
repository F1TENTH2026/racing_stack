<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>
            <Interfaces>
                <NetworkInterface address="127.0.0.1" multicast="true"/>
                <!-- Local development laptop (Ubuntu's predictable WiFi name). -->
                <NetworkInterface name="wlo1" multicast="true" presence_required="false"/>
                <NetworkInterface name="wlp0s20f3" multicast="true" presence_required="false"/>
                <NetworkInterface name="wlp9s0" multicast="true" presence_required="false"/>
                <!-- Jetson(차량) 온보드 컴퓨터의 실제 WiFi 인터페이스 이름 -->
                <NetworkInterface name="wlP1p1s0" multicast="true" presence_required="false"/>
            </Interfaces>
            <!-- Keep multicast for discovery only. User data (notably LaserScan
                 and RViz markers) uses unicast, avoiding low-rate multicast
                 airtime on the car/pitwall Wi-Fi link. -->
            <AllowMulticast>spdp</AllowMulticast>
        </General>
        <Discovery>
            <ParticipantIndex>none</ParticipantIndex>
        </Discovery>
        <Internal>
            <!-- setup_conda_onCar.sh raises the matching OS limits to 25 MiB. -->
            <SocketReceiveBufferSize min="10MB"/>
            <SocketSendBufferSize min="10MB"/>
        </Internal>
    </Domain>
</CycloneDDS>
