<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>
            <Interfaces>
                <NetworkInterface address="127.0.0.1" multicast="true"/>
                <!-- Local development laptop (Ubuntu's predictable WiFi name). -->
                <NetworkInterface name="wlo1" multicast="true" presence_required="false"/>
                <NetworkInterface name="wlp0s20f3" multicast="true" presence_required="false"/>
                <NetworkInterface name="wlp9s0" multicast="true" presence_required="false"/>
                <!-- Pitwall(관제 PC, ThirdImpact)의 실제 WiFi 인터페이스 이름 -->
                <NetworkInterface name="wlp67s0" multicast="true" presence_required="false"/>
                <!-- Jetson(차량) 온보드 컴퓨터의 실제 WiFi 인터페이스 이름 -->
                <NetworkInterface name="wlP1p1s0" multicast="true" presence_required="false"/>
            </Interfaces>
            <!-- spdp = discovery(SPDP)만 멀티캐스트, 데이터는 유니캐스트.
                 'true'는 데이터까지 멀티캐스트를 허용하는데, WiFi에서 멀티캐스트
                 프레임은 최저 basic rate(보통 1~6 Mbps)로 ACK 없이 나간다.
                 40 Hz /scan(8.5 KB)을 그렇게 보내면 채널 airtime을 잡아먹고
                 재전송이 늘어, pitwall을 붙이는 순간 차량이 느려지는 원인이 된다.
                 노드 발견은 그대로 동작한다. -->
            <AllowMulticast>spdp</AllowMulticast>
        </General>
        <Discovery>
            <!-- 'none'은 유니캐스트 포트가 임의값이 되어 아래 Peers가 찾아갈 수
                 없다. 'auto'는 포트를 participant index로 결정적으로 만들어
                 피어가 계산해서 찔러볼 수 있게 한다. -->
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>4</MaxAutoParticipantIndex>
            <!-- 아이폰 개인용 핫스팟(172.20.10.0/28)은 클라이언트 간 멀티캐스트를
                 전달하지 않는다. ping/SSH(유니캐스트)는 되는데 SPDP(멀티캐스트)만
                 죽어서 pitwall과 차량이 서로를 못 본다. 유니캐스트 피어를 명시해
                 우회한다. 멀티캐스트가 정상인 공유기에서는 이 목록이 있어도
                 무해하다(양쪽 경로를 다 쓴다). 핫스팟 대역이 바뀌면 여기도 수정. -->
            <Peers>
                <Peer address="172.20.10.2"/>
                <Peer address="172.20.10.3"/>
                <Peer address="172.20.10.4"/>
                <Peer address="172.20.10.5"/>
                <Peer address="172.20.10.6"/>
                <Peer address="172.20.10.7"/>
                <Peer address="172.20.10.8"/>
                <Peer address="172.20.10.9"/>
                <Peer address="172.20.10.10"/>
                <Peer address="172.20.10.11"/>
                <Peer address="172.20.10.12"/>
                <Peer address="172.20.10.13"/>
                <Peer address="172.20.10.14"/>
            </Peers>
        </Discovery>
        <Internal>
            <!-- OS 기본값(보통 208 KB)은 40 Hz x 8.5 KB의 /scan에 마커까지
                 겹치는 버스트에서 부족하다. 넘치면 조용히 버려지고, RELIABLE
                 토픽은 재전송으로 이어져 발행 측 CPU를 더 쓴다. -->
            <SocketReceiveBufferSize min="10MB"/>
            <SocketSendBufferSize min="10MB"/>
        </Internal>
    </Domain>
</CycloneDDS>
